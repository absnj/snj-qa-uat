const fs = require('fs');
const path = require('path');
const dotenv = require('dotenv');

const envPath = path.join(__dirname, '.env');
dotenv.config({ path: envPath });

const csvPath = path.join(__dirname, 'uat-matrix.csv');
const outDir = path.join(__dirname, 'generated');
const csvContent = fs.readFileSync(csvPath, 'utf8').trim();

function parseCsv(text) {
  const lines = text.split(/\r?\n/).filter(Boolean);
  const headers = lines.shift().split(',').map(h => h.trim());
  return lines.map(line => {
    const columns = line.split(/,(?=(?:[^\"]*\"[^\"]*\")*[^\"]*$)/).map(cell => cell.trim().replace(/^"|"$/g, ''));
    return headers.reduce((row, header, index) => {
      row[header] = columns[index] || '';
      return row;
    }, {});
  });
}

function slug(value) {
  return value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

function escapeForRegex(text) {
  return text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

function roleEnvKey(role, suffix) {
  const normalized = role
    .toUpperCase()
    .replace(/[^A-Z0-9]+/g, '_')
    .replace(/^_+|_+$/g, '');
  return `UAT_${normalized}_${suffix}`;
}

function buildLoginSteps(role, invalid = false) {
  const userKey = roleEnvKey(role, 'USER');
  const passKey = roleEnvKey(role, 'PASSWORD');
  const passwordSource = `process.env.${passKey} || process.env.UAT_PASSWORD || 'TODO_PASSWORD'`;
  return [
    `  // Login credentials are driven from environment variables.`,
    `  // Define them in tests/.env or via your CI environment.`,
    `  await page.getByRole('textbox', { name: 'Email Address' }).fill(process.env.${userKey} || process.env.UAT_USER || 'TODO_USERNAME');`,
    invalid
      ? `  await page.getByRole('textbox', { name: 'Password' }).fill((${passwordSource}) + 'invalid'); // append 'invalid' to ensure credentials are wrong`
      : `  await page.getByRole('textbox', { name: 'Password' }).fill(${passwordSource});`,
    "  await page.getByRole('button', { name: 'Sign In' }).click();",
  ];
}

function buildLogoutSteps() {
  return [
    "  await page.getByRole('button', { name: /logout|sign out/i }).click();",
    "  await page.getByRole('button', { name: /sign in|log in|login/i }).toBeVisible();",
  ];
}

function isLoginScenario(row) {
  const text = `${row['Test Scenario']} ${row['Operation']} ${row['Feature/Module']}`.toLowerCase();
  return /login|sign in|sign-in|authenticate|credentials/.test(text);
}

function isLogoutScenario(row) {
  const text = `${row['Test Scenario']} ${row['Operation']} ${row['Feature/Module']}`.toLowerCase();
  return /logout|sign out|sign-out|log out/.test(text);
}

function isSessionScenario(row) {
  const text = `${row['Test Scenario']} ${row['Operation']} ${row['Feature/Module']}`.toLowerCase();
  return /session|timeout|concurrent/.test(text);
}

function renderTestBody(row) {
  const lines = [
    "  await page.goto(UAT_URL); // TODO: replace with actual UAT landing page or login page URL",
    `  // Role: ${row['Role']}`,
    `  // Feature/Module: ${row['Feature/Module']}`,
    `  // Operation: ${row['Operation']}`,
    `  // Expected Behavior: ${row['Expected Behavior']}`,
  ];

  const invalidLogin = /invalid|fail|error/.test(row['Test Scenario'].toLowerCase());

  if (isLoginScenario(row)) {
    lines.push('');
    lines.push('  // Login flow skeleton');
    lines.push(...buildLoginSteps(row['Role'], invalidLogin));
    lines.push('');
    if (invalidLogin) {
      lines.push("  await expect(page.getByRole('alert', { name: 'Invalid email or password.' })).toBeVisible(); // TODO verify actual error message");
    } else {
      lines.push("  await expect(page.getByRole('heading', { name: 'Welcome to ShopNJoy' })).toBeVisible(); // updated to match actual post-login landing selector");
    }
    return { implemented: true, lines };
  }

  lines.push('');
  lines.push('  // Login flow skeleton');
  lines.push(...buildLoginSteps(row['Role']));

  if (isLogoutScenario(row)) {
    lines.push('');
    lines.push('  // Logout skeleton');
    lines.push(...buildLogoutSteps());
    return { implemented: true, lines };
  }

  if (isSessionScenario(row)) {
    lines.push('');
    lines.push('  // TODO: session behavior is environment-specific and may require backend support or manual setup');
    lines.push('  // Example: validate that an expired session redirects to the login page.');
    return { implemented: false, lines };
  }

  lines.push('');
  lines.push('  // TODO: implement navigation and actions for this scenario using robust selectors: getByRole, getByLabel, getByText');
  lines.push('  // Example placeholders:');
  lines.push(`  //   await page.getByRole('link', { name: /${escapeForRegex(row['Feature/Module'])}/i }).click();`);
  lines.push(`  //   await page.getByRole('button', { name: /create|save|export|send|process|update|delete/i }).click();`);
  lines.push('  //   await expect(page.getByText(/expected|success|error/i)).toBeVisible();');
  return { implemented: false, lines };
}

function generateFile(role, roleRows) {
  const title = `UAT matrix role: ${role}`;
  const tests = roleRows.map(row => {
    const testTitle = `${row['Test Scenario']} [${row['Feature/Module']} | ${row['Operation']}]`;
    const { implemented, lines } = renderTestBody(row);
    const marker = implemented ? 'test' : 'test.skip';
    return [
      `  ${marker}('${testTitle}', async ({ page }) => {`,
      ...lines,
      '  });',
      '',
    ].join('\n');
  });

  return [
    "import { test, expect } from '@playwright/test';",
    "",
    "const UAT_URL = process.env.UAT_URL || 'http://localhost:3000';",
    "",
    `test.describe('${title}', () => {`,
    '',
    ...tests,
    '});',
    '',
  ].join('\n');
}

function main() {
  const rows = parseCsv(csvContent);
  const grouped = rows.reduce((acc, row) => {
    const role = row['Role'] || 'Unknown';
    if (/^all roles$/i.test(role)) return acc;
    acc[role] = acc[role] || [];
    acc[role].push(row);
    return acc;
  }, {});

  fs.mkdirSync(outDir, { recursive: true });

  Object.entries(grouped).forEach(([role, roleRows]) => {
    const fileName = `uat-${slug(role)}.spec.ts`;
    const filePath = path.join(outDir, fileName);
    fs.writeFileSync(filePath, generateFile(role, roleRows), 'utf8');
    console.log(`Generated ${path.relative(process.cwd(), filePath)}`);
  });
}

main();
