# UAT environment variables. Copy to .env and fill in real values.
# Never commit .env — it's gitignored. Get values from a teammate.

UAT_URL=

# Backend API host for API-level integration tests (tests/specs/api/).
# May differ from UAT_URL, which is the admin dashboard frontend origin —
# confirm the actual UAT backend host with a teammate.
UAT_API_URL=

# The merchant store / branch that UAT_MERCHANT_ADMIN_USER (etc.) manages —
# needed because Deals/Loyalty creation payloads take raw IDs, not names.
# The UI tests avoid this by clicking branches by display name; the API tests
# cannot. Likely the "Hajime" merchant's store/branch IDs given the existing
# UAT_MERCHANT_ADMIN_USER credential and the "Hajime - My Village" /
# "Hajime - Thomson Plaza" branches already used by njoybook specs — confirm
# the actual IDs with a teammate or via GET /branches.
UAT_API_MERCHANT_STORE_ID=
UAT_API_BRANCH_ID=

UAT_SUPERUSER_USER=
UAT_SUPERUSER_PASSWORD=

UAT_MERCHANT_ADMIN_USER=
UAT_MERCHANT_ADMIN_PASSWORD=

UAT_MERCHANT_STAFF_USER=
UAT_MERCHANT_STAFF_PASSWORD=

UAT_BRANCH_ADMIN_USER=
UAT_BRANCH_ADMIN_PASSWORD=

UAT_BRANCH_STAFF_USER=
UAT_BRANCH_STAFF_PASSWORD=

UAT_SALES_AGENT_USER=
UAT_SALES_AGENT_PASSWORD=

UAT_MERCHANT_SUCCESS_STAFF_USER=
UAT_MERCHANT_SUCCESS_STAFF_PASSWORD=
